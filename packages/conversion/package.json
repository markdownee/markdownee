{
  "name": "@markdownee/conversion",
  "version": "0.5.0-alpha.3",
  "private": true,
  "description": "Converts secured semantic HTML into Markdownee's txt, Markdown, readable HTML, and minified HTML output formats.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@markdownee/schema": "workspace:*",
    "@mixmark-io/domino": "^2.2.0",
    "marked": "^18.0.12",
    "prettier": "^3.9.6",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
