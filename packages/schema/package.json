{
  "name": "@markdownee/schema",
  "version": "0.5.0-alpha.3",
  "private": true,
  "description": "Single source of truth for Markdownee input — Zod 4 schema plus the Apify INPUT_SCHEMA generator that compiles it to disk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
